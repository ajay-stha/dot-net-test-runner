<Window
    x:Class="DotNetTestRunner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DotNetTestRunner.Presentation.ViewModels"
    xmlns:behaviors="clr-namespace:DotNetTestRunner.Presentation.Behaviors"
    x:Name="RootWindow"
    Title=".NET Test Runner"
    Width="1180"
    Height="720"
    MinWidth="980"
    MinHeight="620"
    Background="{StaticResource BackgroundBrush}"
    FontSize="{Binding UiFontSize}"
    Icon="test.ico"
    PreviewMouseWheel="Window_PreviewMouseWheel"
    ResizeMode="CanResize"
    WindowState="Maximized"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="52"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  App Header Bar (custom title bar) — same design as .NET Publisher.  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource HeaderBarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  App icon  -->
                <Image
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="test.ico" />

                <!--  Accent bar  -->
                <Border
                    Grid.Column="1"
                    Width="4"
                    Height="34"
                    Margin="14,0,14,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentBarBrush}"
                    CornerRadius="2" />

                <StackPanel
                    Grid.Column="2"
                    Margin="0,9"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppTitleText}" Text=".NET Test Runner" />
                    <TextBlock
                        Margin="0,1,0,0"
                        Style="{StaticResource AppSubtitleText}"
                        Text="Discover and run dotnet tests from a solution or project" />
                </StackPanel>

                <!--  Caption buttons  -->
                <StackPanel
                    Grid.Column="4"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        Click="MinimizeButton_Click"
                        Content="&#xE921;"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="Minimize" />
                    <Button
                        x:Name="MaximizeRestoreButton"
                        Click="MaximizeRestoreButton_Click"
                        Content="&#xE922;"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="Maximize" />
                    <Button
                        Click="CloseButton_Click"
                        Content="&#xE8BB;"
                        Style="{StaticResource CloseCaptionButton}"
                        ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
        <Grid.Resources>
            <!--
                Shared brushes, converters, and generic control styles live in
                Styles/Styles.xaml and are merged at the Application level (see App.xaml).
                Only view-specific data templates (bound to this window's view model types)
                are defined here.
            -->
            <HierarchicalDataTemplate DataType="{x:Type vm:TestClassNode}" ItemsSource="{Binding Methods}">
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Focusable="False"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        IsThreeState="True"
                        ToolTip="Select all tests in this class" />
                    <Grid
                        Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                        Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="ClassNotRunIcon"
                            Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                            Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="Transparent"
                            Stroke="{StaticResource SecondaryTextBrush}"
                            StrokeThickness="{Binding DataContext.TreeIconStrokeThickness, Source={x:Reference RootWindow}}"
                            Visibility="Visible" />
                        <Viewbox x:Name="ClassCheckIcon"
                                 Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                                 Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 Stretch="Uniform">
                            <Canvas Width="14" Height="14">
                                <Path Data="M 2 7 L 5.5 11 L 12 3"
                                      Stroke="{StaticResource SuccessBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2.4" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="ClassCrossIcon"
                                 Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                                 Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 Stretch="Uniform">
                            <Canvas Width="14" Height="14">
                                <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                      Stroke="{StaticResource DangerBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2.4" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox
                            x:Name="ClassSpinnerIcon"
                            Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                            Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform"
                            Visibility="Collapsed">
                            <Viewbox.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Viewbox.RenderTransform>
                            <Canvas Width="12" Height="12">
                                <Path
                                    Data="M 6,1 A 5,5 0 0 1 10.5,6"
                                    Stroke="{StaticResource AccentBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.5" />
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <TextBlock Text="{Binding ClassName}" TextWrapping="Wrap">
                        <TextBlock.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding DataContext.RunClassCommand, Source={x:Reference RootWindow}}"
                                    CommandParameter="{Binding}"
                                    Header="Run Class Tests" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:TestRunState.None}">
                        <Setter TargetName="ClassNotRunIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:TestRunState.Passed}">
                        <Setter TargetName="ClassNotRunIcon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="ClassCheckIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:TestRunState.Failed}">
                        <Setter TargetName="ClassNotRunIcon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="ClassCrossIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:TestRunState.Running}">
                        <Setter TargetName="ClassNotRunIcon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="ClassSpinnerIcon" Property="Visibility" Value="Visible" />
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="ClassSpinnerStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="ClassSpinnerIcon"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                        From="0"
                                        To="360"
                                        Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="ClassSpinnerStoryboard" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type vm:TestMethodNode}">
                <StackPanel Margin="2,1,0,1" Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Focusable="False"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        ToolTip="Select this test" />
                    <Grid
                        Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                        Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="MethodNotRunIcon"
                            Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                            Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="Transparent"
                            Stroke="{StaticResource SecondaryTextBrush}"
                            StrokeThickness="{Binding DataContext.TreeIconStrokeThickness, Source={x:Reference RootWindow}}"
                            Visibility="Visible" />
                        <Viewbox x:Name="MethodCheckIcon"
                                 Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                                 Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 Stretch="Uniform">
                            <Canvas Width="14" Height="14">
                                <Path Data="M 2 7 L 5.5 11 L 12 3"
                                      Stroke="{StaticResource SuccessBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2.4" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="MethodCrossIcon"
                                 Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                                 Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 Stretch="Uniform">
                            <Canvas Width="14" Height="14">
                                <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                                      Stroke="{StaticResource DangerBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2.4" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox
                            x:Name="MethodSpinnerIcon"
                            Width="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                            Height="{Binding DataContext.TreeIconSize, Source={x:Reference RootWindow}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform"
                            Visibility="Collapsed">
                            <Viewbox.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Viewbox.RenderTransform>
                            <Canvas Width="12" Height="12">
                                <Path
                                    Data="M 6,1 A 5,5 0 0 1 10.5,6"
                                    Stroke="{StaticResource AccentBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.5" />
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <TextBlock Text="{Binding MethodName}" TextWrapping="Wrap">
                        <TextBlock.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding DataContext.RunMethodCommand, Source={x:Reference RootWindow}}"
                                    CommandParameter="{Binding}"
                                    Header="Run This Test" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:TestRunState.None}">
                        <Setter TargetName="MethodNotRunIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:TestRunState.Passed}">
                        <Setter TargetName="MethodNotRunIcon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="MethodCheckIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:TestRunState.Failed}">
                        <Setter TargetName="MethodNotRunIcon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="MethodCrossIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:TestRunState.Running}">
                        <Setter TargetName="MethodNotRunIcon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="MethodSpinnerIcon" Property="Visibility" Value="Visible" />
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="MethodSpinnerStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="MethodSpinnerIcon"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                        From="0"
                                        To="360"
                                        Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="MethodSpinnerStoryboard" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Target + configuration card. Combined into a single elevated card (two stacked rows) to cut down on toolbar clutter.  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="14,12"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Target (.sln/.csproj):" />

                    <TextBox
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsReadOnly="True"
                        Text="{Binding TargetPath}" />

                    <Button
                        Grid.Column="4"
                        Command="{Binding BrowseTargetCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Text="&#xE8B7;" />
                            <TextBlock VerticalAlignment="Center" Text="Browse..." />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Configuration:" />

                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsEditable="False"
                        ItemsSource="{Binding Configurations}"
                        SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding StatusText}" />
                </Grid>
            </Grid>
        </Border>

        <!--  Action toolbar. Run All is the high-emphasis primary action; Run Selected is medium-emphasis; the rest are low-emphasis ghost buttons.  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="10"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding RefreshTestsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Text="&#xE72C;" />
                        <TextBlock VerticalAlignment="Center" Text="Refresh Tests" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{Binding RunAllCommand}"
                    Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Foreground="White"
                            Text="&#xE768;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="Run All" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="4"
                    Command="{Binding RunSelectedCommand}"
                    Style="{StaticResource AccentOutlineButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Foreground="{StaticResource AccentBrush}"
                            Text="&#xE73E;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AccentBrush}"
                            Text="Run Selected" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" Command="{Binding ClearSelectionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Text="&#xE711;" />
                        <TextBlock VerticalAlignment="Center" Text="Clear Selection" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="8" Command="{Binding ClearLogCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Text="&#xE74D;" />
                        <TextBlock VerticalAlignment="Center" Text="Clear Log" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="10"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="280" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="3*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource AccentBrush}"
                            Text="&#xE8B7;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="Test Explorer" />
                    </StackPanel>

                    <TreeView Grid.Row="1" ItemsSource="{Binding TestClasses}">
                        <TreeView.ItemContainerStyle>
                            <StaticResource ResourceKey="DarkTreeViewItemStyle" />
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>

                <GridSplitter
                    Grid.Column="1"
                    Width="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource BorderBrush}"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    ShowsPreview="True" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{StaticResource AccentBrush}"
                                Text="&#xE756;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="Execution Output" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Border
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{StaticResource RunningSubtleBrush}"
                                CornerRadius="10"
                                Visibility="{Binding IsRunInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <ProgressBar
                                        Width="60"
                                        Height="6"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        IsIndeterminate="True" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="Running" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{StaticResource SuccessSubtleBrush}"
                                CornerRadius="10"
                                Visibility="{Binding IsLastRunPassed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Data="M 1 5 L 4 8 L 10 2"
                                        Stroke="{StaticResource SuccessBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SuccessBrush}"
                                        Text="Passed" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{StaticResource DangerSubtleBrush}"
                                CornerRadius="10"
                                Visibility="{Binding IsLastRunFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Data="M 2 2 L 10 10 M 10 2 L 2 10"
                                        Stroke="{StaticResource DangerBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DangerBrush}"
                                        Text="Failed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <RichTextBox
                        Grid.Row="1"
                        behaviors:OutputLogBehavior.Text="{Binding OutputLog}" />
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
